rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(createdBy) {
      return isAuthenticated() && request.auth.uid == createdBy;
    }

    // Waypoints collection rules (e.g. parking spots, meetup spots)
    match /waypoints/{waypointId} {
      allow read: if true; // Publicly shareable by design via share link
      allow create: if isAuthenticated() 
                    && request.resource.data.createdBy == request.auth.uid
                    && request.resource.data.locationName is string
                    && request.resource.data.locationName.size() < 150
                    && request.resource.data.createdAt == request.time;
      allow update, delete: if isOwner(resource.data.createdBy)
                            && (request.resource == null || request.resource.data.createdBy == resource.data.createdBy);
    }

    // Real-time alerts collection rules
    match /alerts/{alertId} {
      allow read: if true; // Any client can read alerts
      allow write: if isAuthenticated() && request.auth.token.admin == true; // Only admin users can post/update/delete alerts
    }
  }
}
